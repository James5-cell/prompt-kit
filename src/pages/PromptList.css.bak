/* PromptList.css - Overhauled Prompt Explorer styles with sliding drawers */

.prompt-explorer-page {
  padding: 40px;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

/* Explore Header */
.explorer-header {
  border-bottom: 1px solid var(--border);
}

/* Filters Workspace Card Panel */
.filter-workspace {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.15);
}

.filter-grid {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
}

.search-box-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 260px;
}

.search-box-icon {
  position: absolute;
  left: 12px;
  pointer-events: none;
}

.search-box-input {
  width: 100%;
  padding: 10px 14px 10px 36px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background-color: var(--surface-2);
  color: var(--text);
  outline: none;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.search-box-input:focus {
  border-color: var(--primary);
  background-color: #050508;
  box-shadow: 0 0 10px rgba(0, 229, 255, 0.15);
}

.admin-status-dropdown {
  padding: 10px 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background-color: var(--surface-2);
  color: var(--text-muted);
  outline: none;
  cursor: pointer;
  min-width: 130px;
  transition: all 0.2s;
}

.admin-status-dropdown:focus {
  border-color: var(--primary);
}

/* Segmented Category Buttons bar */
.category-segmented-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  padding-bottom: 8px;
}

.segmented-tab {
  padding: 6px 12px;
  border-radius: var(--radius-xs);
  font-size: 11px;
  font-family: var(--font-mono);
  text-transform: uppercase;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  background: var(--surface-2);
  border: 1px solid var(--border);
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.segmented-tab:hover {
  background: var(--surface);
  border-color: var(--border-strong);
  color: var(--text);
}

.segmented-tab.active {
  background: var(--primary-muted);
  border-color: var(--primary) !important;
  color: var(--primary);
  box-shadow: 0 0 10px rgba(0, 229, 255, 0.1);
}

/* Active Chips & filters metadata */
.active-tag-chips {
  display: flex;
  gap: 6px;
  align-items: center;
}

.active-tag-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 10px;
  font-weight: 500;
  border: 1px solid rgba(0, 229, 255, 0.25);
  background: var(--primary-muted);
  color: var(--primary);
}

.active-tag-chip button {
  background: none;
  border: none;
  color: inherit;
  cursor: pointer;
  padding: 0;
  display: inline-flex;
  align-items: center;
}

.clear-all-filters-btn {
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  transition: all 0.2s;
}

/* Tag Selector Dropdown Popover */
.tag-popover-container {
  min-width: 140px;
}

.tag-popover-trigger {
  padding: 10px 14px;
  min-width: 130px;
  text-align: left;
}

.popover-count-badge {
  opacity: 0.7;
}

.tag-popover-dropdown {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  min-width: 220px;
  background-color: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
  z-index: 50;
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.tag-popover-search-input {
  width: 100%;
  padding: 6px 10px;
  border: 1px solid var(--border);
  border-radius: 4px;
  background-color: var(--surface-2);
  color: var(--text);
  font-size: 12px;
  outline: none;
  box-sizing: border-box;
}

.tag-popover-search-input:focus {
  border-color: var(--primary);
}

.tag-popover-list {
  max-height: 160px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.tag-popover-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 12px;
  color: var(--text-muted);
  user-select: none;
}

.tag-popover-item:hover {
  background-color: var(--surface-2);
  color: var(--text);
}

.tag-popover-item input[type="checkbox"] {
  margin: 0;
  accent-color: var(--primary);
}

.tag-popover-item-name {
  flex: 1;
}

.tag-popover-item-count {
  font-size: 10px;
  color: var(--text-faint);
}

.tag-popover-empty {
  padding: 12px;
  text-align: center;
  color: var(--text-faint);
  font-size: 11px;
}

/* ── C. Responsive Grid Layout of Explorer Cards ────────── */
.explorer-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 16px;
}

/* Prompt Card visual styling */
.prompt-explorer-card {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 20px;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  --card-glow-color: rgba(255, 255, 255, 0.02);
}

.prompt-explorer-card:hover {
  transform: translateY(-2px);
  border-color: var(--border-strong);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25), 0 0 15px var(--card-glow-color);
}

.explorer-cat-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  padding: 2px 8px;
  border-radius: 4px;
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--border);
}

.explorer-cat-badge.theme-dev { background: var(--color-dev-bg); }
.explorer-cat-badge.theme-finance { background: var(--color-finance-bg); }
.explorer-cat-badge.theme-writing { background: var(--color-writing-bg); }
.explorer-cat-badge.theme-thinking { background: var(--color-thinking-bg); }
.explorer-cat-badge.theme-learning { background: var(--color-learning-bg); }
.explorer-cat-badge.theme-tools { background: var(--color-tools-bg); }
.explorer-cat-badge.theme-translation { background: var(--color-translation-bg); }

.explorer-card-title {
  margin: 0;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.3;
}

.explorer-card-title a {
  color: var(--text);
  text-decoration: none;
}

.explorer-card-summary {
  margin: 8px 0 0 0;
  min-height: 36px;
  line-height: 1.5;
}

.explorer-tag-pill {
  padding: 2px 8px;
  border-radius: 12px;
  border: 1px solid var(--border);
  color: var(--text-faint);
  background-color: rgba(255,255,255,0.01);
}

.explorer-tag-pill-more {
  padding: 2px 6px;
  font-weight: 600;
}

.fav-star-btn {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--text-faint);
  padding: 4px;
  transition: all 0.2s;
  display: inline-flex;
}

.fav-star-btn:hover {
  color: var(--warning);
}

.fav-star-btn.favorited {
  color: var(--warning);
}

.delete-card-btn {
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  display: inline-flex;
}

/* Explorer empty status */
.explorer-empty {
  padding: 60px 20px;
  background-color: var(--surface);
  border: 1px dashed var(--border);
  border-radius: var(--radius-md);
}

/* ── D. Interactive Sandbox Slide-Over Drawer ─────────────── */

.sandbox-drawer-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(5, 5, 8, 0.7);
  backdrop-filter: blur(4px);
  z-index: 999;
}

.sandbox-drawer-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 440px;
  max-width: 100vw;
  background-color: var(--surface);
  box-shadow: -10px 0 40px rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.drawer-body {
  flex: 1;
}

.drawer-textarea {
  resize: vertical;
}

.drawer-notice {
  line-height: 1.5;
}

.drawer-output-console {
  min-height: 220px;
  color: var(--text-muted);
}

.drawer-output-console.error {
  border-color: rgba(255, 69, 58, 0.2);
}

.drawer-output-console pre {
  margin: 0;
}

.terminal-scan-line {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
  background-size: 100% 4px, 6px 100%;
  pointer-events: none;
  z-index: 5;
  opacity: 0.1;
}

.pulse-loading {
  animation: borderGlow 1.5s infinite;
}

@keyframes borderGlow {
  0% { box-shadow: 0 0 10px rgba(0, 229, 255, 0.2); }
  50% { box-shadow: 0 0 20px rgba(0, 229, 255, 0.45); }
  100% { box-shadow: 0 0 10px rgba(0, 229, 255, 0.2); }
}

/* ── Prefers Reduced Motion Compatibility ────────────────── */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-delay: -1ms !important;
    animation-duration: 1ms !important;
    animation-iteration-count: 1 !important;
    background-attachment: initial !important;
    scroll-behavior: auto !important;
    transition-duration: 0s !important;
    transition-delay: 0s !important;
  }
  
  .pulse-loading,
  .animate-pulse,
  .animate-ping {
    animation: none !important;
  }

  .sandbox-drawer-panel {
    transform: none !important;
    transition: none !important;
  }
}

/* ── Mobile Layout Adjustments ───────────────────────────── */
@media (max-width: 768px) {
  .prompt-explorer-page {
    padding: 16px 16px 80px;
  }

  .explorer-header h1 {
    font-size: 24px;
  }

  .filter-workspace {
    padding: 16px;
  }

  .filter-grid {
    flex-direction: column;
    align-items: stretch;
  }

  .search-box-wrapper {
    min-width: 100%;
  }

  .tag-popover-container {
    width: 100%;
  }

  .tag-popover-dropdown {
    width: 100%;
    left: 0;
    right: 0;
  }

  .explorer-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  /* Slide up panel / bottom sheet style for mobile */
  .sandbox-drawer-panel {
    width: 100vw;
    height: 85vh;
    top: auto;
    bottom: 0;
    border-top: 1px solid var(--border);
    border-left: none;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }
}
