    "@ai-sdk/openai": "^3.0.61",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/react": "^6.0.2",
    "ai": "^6.0.175",
    "autoprefixer": "^10.5.0",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.10.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
